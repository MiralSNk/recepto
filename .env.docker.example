# Шаблон для docker-compose.prod.yml. Скопируйте в .env.docker (не
# коммитится) и заполните реальными значениями. В отличие от .env.example
# (для запуска без Docker) — DB_HOST здесь имя сервиса ("mysql"), а не
# "localhost": контейнеры общаются друг с другом по имени сервиса из
# docker-compose, не через сетевой стек хост-машины.

# --- База данных (MySQL) ---
# Не меняйте DB_HOST/DB_PORT — это имя сервиса mysql и порт ВНУТРИ сети
# docker-compose, наружу этот порт не пробрасывается.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=recepto_db
DB_USER=recepto
DB_PASSWORD=замените-на-надёжный-пароль
# Пароль root-пользователя MySQL — используется только самим контейнером
# mysql при первой инициализации, приложение им не пользуется.
DB_ROOT_PASSWORD=замените-на-другой-надёжный-пароль

# --- Домен (для Caddy — автоматический HTTPS) ---
# Свой домен, например site.ru. Убедитесь, что его DNS A-запись уже
# указывает на IP этого сервера — иначе Caddy не сможет получить сертификат
# Let's Encrypt при первом запуске.
DOMAIN=example.com

# --- Аутентификация (NextAuth) ---
NEXTAUTH_SECRET=замените-на-случайную-строку
NEXTAUTH_URL=https://example.com

# --- Первый администратор (одноразово; после первого успешного запуска
# можно убрать обе строки из .env.docker — контейнер это переживёт, см.
# docker-entrypoint.sh) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=замените-на-надёжный-пароль

# --- Почта (уведомления о брони/обращениях) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_TO=admin@example.com

# --- YandexGPT (ИИ-чат-помощник) ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# --- Yandex SmartCaptcha ---
YANDEX_CAPTCHA_SERVERKEY=
NEXT_PUBLIC_YANDEX_CAPTCHA_SITEKEY=

# --- Прочее ---
NEXT_PUBLIC_SITE_URL=https://example.com
