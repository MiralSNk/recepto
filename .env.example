# Скопируйте в .env.local (разработка) или .env.production (сервер) и
# заполните реальными значениями. Ни один из этих файлов не коммитится.

# --- База данных (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=recepto_db

# --- Аутентификация (NextAuth) ---
NEXTAUTH_SECRET=замените-на-случайную-строку
# Обязательно http://localhost:3000 в разработке и реальный https://домен
# на проде — NextAuth определяет по схеме (http/https), ставить ли secure-флаг
# на cookie сессии.
NEXTAUTH_URL=http://localhost:3000

# --- Первый администратор (одноразовый запуск: pnpm admin:bootstrap) ---
# Ничего не создаёт, если в таблице users уже есть хотя бы одна запись —
# нужны только на самом первом разворачивании на чистой базе.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=замените-на-надёжный-пароль

# --- Почта (уведомления о брони/обращениях) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
# Технический адрес, куда реально приходят заявки с сайта — не совпадает с
# hotel_email из SEO-админки (та почта только отображается посетителям).
MAIL_TO=admin@example.com

# --- YandexGPT (ИИ-чат-помощник) ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# --- Yandex SmartCaptcha (защита форм брони/обратной связи) ---
YANDEX_CAPTCHA_SERVERKEY=
NEXT_PUBLIC_YANDEX_CAPTCHA_SITEKEY=

# --- Прочее ---
# Публичный URL сайта — используется в метаданных (canonical/OG/sitemap) и
# сборкой чат-виджета на клиенте. Смена значения требует пересборки
# (pnpm build), просто перезапуска процесса недостаточно — см. README.
NEXT_PUBLIC_SITE_URL=https://example.com
