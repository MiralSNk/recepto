# Тестовая БД для интеграционных тестов (pnpm test:integration).
# Поднимается через docker-compose.yml — отдельный порт/имя БД, чтобы не
# затронуть локальную БД разработки. Не секрет: пустой пароль только внутри
# эфемерного тестового контейнера.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=recepto_test
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test-secret-not-for-production
