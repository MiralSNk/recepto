{
  "name": "recepto",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate-mysql.mjs",
    "db:migrate:test": "dotenv -e .env.test -- node scripts/migrate-mysql.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "assets:favicons": "node scripts/generate-favicons.mjs",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:integration": "docker compose up -d --wait mysql-test && pnpm db:migrate:test && dotenv -e .env.test -- vitest run --project integration",
    "test:integration:down": "docker compose down"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/react-datepicker": "^7.0.0",
    "@yandex/smart-captcha": "^2.9.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "gsap": "^3.15.0",
    "mysql2": "^3.23.3",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-date-range": "^2.0.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.8",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
}
